# Copiar como .env.local para desarrollar. En Vercel va en Settings > Environment Variables.

# La clave entre el servidor del juego y la base: nunca se sube ni se comparte.
# Sin ella el juego valida igual en desarrollo, pero no guarda nada.
ASTRILLON_API_SECRETO=

# Sólo en Vercel: "si" enciende el límite de pedidos por conexión (src/servidor/limites.ts).
ASTRILLON_LIMITES=

# Sólo en desarrollo: "supabase" hace que el servidor local lea el banco de la base en vez del disco
# (privado/banco.ts si está en esta máquina, o src/datos/banco-ejemplo.json si no).
ASTRILLON_BANCO=

# Sólo para scripts/banco/descargar.mjs: un mail de contacto para las consultas a Wikidata.
ASTRILLON_CONTACTO=
